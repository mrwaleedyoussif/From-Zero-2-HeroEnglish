{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(npx supabase:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./coverage/**)",
      "Read(./playwright-report/**)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -E '\\.(ts|tsx|css|json|md)$' | xargs -r npx prettier --write >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
