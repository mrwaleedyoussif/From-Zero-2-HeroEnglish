# LinguaPath environment variables
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable is checked at startup by src/lib/env.schema.ts.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Timezone used for schedules and daily limits.
DEFAULT_TIMEZONE=Asia/Riyadh

# ---------------------------------------------------------------------------
# Supabase
# Local: run `npx supabase start`, then `npx supabase status` prints these.
# Hosted: Supabase dashboard -> Project Settings -> API / Database.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public "anon" key (safe in the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Direct Postgres connection, used by database tests and scripts.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Encrypts stored tokens (AES-256-GCM). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Protects scheduled-job endpoints. At least 32 characters.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Content storage (Google Drive)
# ---------------------------------------------------------------------------
# google = the Owner's Google Drive; fake = a local folder with the same layout (dev/tests).
STORAGE_DRIVER=fake
# Required when STORAGE_DRIVER=fake: path to the local folder.
FAKE_DRIVE_DIR=./.fake-drive

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application).
# Optional until Drive is connected.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Optional fallback when the Owner has not connected Drive in the app yet
# (scripts, first deploy).
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# console = print emails to the server log (dev); resend; gmail.
MAIL_PROVIDER=console
# Required when MAIL_PROVIDER=resend. From resend.com -> API Keys.
RESEND_API_KEY=
# Sender shown on outgoing email. The domain must be verified with the provider.
MAIL_FROM=LinguaPath <reports@example.com>
# Maximum emails sent per day (0-100).
EMAIL_DAILY_BUDGET=90

# ---------------------------------------------------------------------------
# Feature flags ("true" or "false")
# ---------------------------------------------------------------------------
BILLING_ENABLED=false
AI_ENABLED=false

# ---------------------------------------------------------------------------
# Testing only (optional)
# ---------------------------------------------------------------------------
# E2E_BASE_URL=http://localhost:3000
# MAILPIT_URL=http://127.0.0.1:54324
