{
  "name": "linguapath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local > src/types/db.ts.tmp && mv src/types/db.ts.tmp src/types/db.ts || (rm -f src/types/db.ts.tmp; exit 1)",
    "db:seed": "bash scripts/db-seed.sh",
    "db:reset": "supabase db reset",
    "test:db": "vitest run --config vitest.db.config.mts",
    "owner:create": "node scripts/create-owner.mts",
    "gen:gate": "node scripts/gen-gate.mts",
    "drive:init": "node --conditions=react-server --import tsx scripts/drive-init.mts",
    "sim:placement": "node scripts/sim-placement.mts",
    "test:coverage": "vitest run --coverage",
    "calibrate": "node --conditions=react-server --import tsx scripts/calibrate.mts"
  },
  "dependencies": {
    "@googleapis/drive": "^27.1.0",
    "@googleapis/sheets": "^18.1.3",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "arabic-persian-reshaper": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
