/**
 * Pure templates for `npm run gen:gate <name>` (tested in gen-gate.test.ts).
 * A new gate = config + route folder + labels + permission migration + regenerated index.
 */

export const GATE_NAME = /^[a-z][a-z0-9]{1,20}$/;

export function gateVar(name: string): string {
  return `${name}Gate`;
}

export function renderConfig(name: string, priority: number): string {
  return `import { defineGate } from "./types";

export const ${gateVar(name)} = defineGate({
  key: "${name}",
  basePath: "/${name}",
  permission: "gate:${name}",
  priority: ${priority},
  theme: "staff",
  nav: [{ key: "nav.${name}.home", href: "/${name}" }],
  homeWidgets: [],
});
`;
}

export function renderLayout(name: string): string {
  return `import { GateLayout } from "@/gates/components/gate-layout";
import { ${gateVar(name)} } from "@/gates/${name}.config";

export default function Layout({ children, params }: LayoutProps<"/[locale]/${name}">) {
  return (
    <GateLayout gate={${gateVar(name)}} params={params}>
      {children}
    </GateLayout>
  );
}
`;
}

export function renderPage(name: string): string {
  return `import { GateHome } from "@/gates/components/gate-home";
import { ${gateVar(name)} } from "@/gates/${name}.config";

export default function Page({ params }: PageProps<"/[locale]/${name}">) {
  return <GateHome gate={${gateVar(name)}} params={params} />;
}
`;
}

/** The generated list of all gates (Next.js cannot discover files at runtime). */
export function renderIndex(names: readonly string[]): string {
  const sorted = [...names].sort();
  const imports = sorted.map((n) => `import { ${gateVar(n)} } from "./${n}.config";`).join("\n");
  return `// GENERATED by \`npm run gen:gate\` — do not edit. Lists every src/gates/*.config.ts.
${imports}
import type { GateConfig } from "./types";

export const gates: readonly GateConfig[] = [${sorted.map(gateVar).join(", ")}];
`;
}

export function renderMigration(name: string): string {
  return `-- Generated by \`npm run gen:gate ${name}\`: entry permission for the ${name} gate.
insert into public.permissions (key, module, description_en, description_ar)
values ('gate:${name}', 'gates', 'Enter the ${name} portal', 'دخول بوابة ${name}')
on conflict (key) do nothing;

-- The Owner (platform system role) holds every permission.
insert into public.role_permissions (role_id, permission_key)
select r.id, 'gate:${name}' from public.roles r
where r.is_system and r.default_scope_type = 'platform'
on conflict (role_id, permission_key) do nothing;
`;
}

type Messages = Record<string, unknown>;

function setPath(obj: Messages, path: string[], value: string): void {
  let node = obj;
  for (const part of path.slice(0, -1)) {
    const next = node[part];
    node[part] = typeof next === "object" && next !== null ? next : {};
    node = node[part] as Messages;
  }
  const last = path.at(-1);
  if (last && node[last] === undefined) node[last] = value;
}

/** Add the gate's labels (Registry.gate.x, Registry.nav.x.home, Registry.page.x.home) without overwriting. */
export function addGateMessages(messages: Messages, name: string): Messages {
  const copy = structuredClone(messages);
  const title = name.charAt(0).toUpperCase() + name.slice(1);
  setPath(copy, ["Registry", "gate", name], title);
  setPath(copy, ["Registry", "nav", name, "home"], title);
  setPath(copy, ["Registry", "page", name, "home"], title);
  return copy;
}

/** Migration file name: next free timestamp after the existing ones. */
export function migrationName(existing: readonly string[], name: string, now: Date): string {
  const stamp = now.toISOString().replace(/\D/g, "").slice(0, 14);
  const latest =
    existing
      .map((f) => f.slice(0, 14))
      .sort()
      .at(-1) ?? "0";
  const next = stamp > latest ? stamp : String(BigInt(latest) + 1n);
  return `${next}_gate_${name}.sql`;
}
